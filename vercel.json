{
  "functions": {
    "api/portal.ts": {
      "maxDuration": 60
    },
    "api/presentation.ts": {
      "includeFiles": "presentation/slides/*.jpg"
    }
  },
  "headers": [
    {
      "source": "/presentation.html",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; connect-src 'self'; img-src 'self' blob:; base-uri 'none'; frame-ancestors 'none'; form-action 'self'" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}

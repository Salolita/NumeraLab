{
  "functions": {
    "api/portal.ts": {
      "maxDuration": 60
    },
    "api/presentation.ts": {
      "includeFiles": "node_modules/@ieaum/platform/legacy-presentation/slides/*.jpg"
    },
    "api/week.ts": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/presentation.html", "destination": "https://ieaum.ir/egtesadkalan/numera-legacy/index.html" },
    { "source": "/presentation/app.js", "destination": "https://ieaum.ir/egtesadkalan/numera-legacy/app.js" },
    { "source": "/presentation/style.css", "destination": "https://ieaum.ir/egtesadkalan/numera-legacy/style.css" },
    { "source": "/presentation/questions.js", "destination": "https://ieaum.ir/egtesadkalan/questions.js" },
    { "source": "/presentation/cover.jpg", "destination": "https://ieaum.ir/egtesadkalan/cover.jpg" },
    { "source": "/presentation/Vazirmatn.woff2", "destination": "https://ieaum.ir/egtesadkalan/Vazirmatn.woff2" },
    { "source": "/presentation/OFL.txt", "destination": "https://ieaum.ir/egtesadkalan/OFL.txt" }
  ],
  "headers": [
    {
      "source": "/presentation.html",
      "rewrites": [
    { "source": "/presentation.html", "destination": "https://ieaum.ir/egtesadkalan/numera-legacy/index.html" },
    { "source": "/presentation/app.js", "destination": "https://ieaum.ir/egtesadkalan/numera-legacy/app.js" },
    { "source": "/presentation/style.css", "destination": "https://ieaum.ir/egtesadkalan/numera-legacy/style.css" },
    { "source": "/presentation/questions.js", "destination": "https://ieaum.ir/egtesadkalan/questions.js" },
    { "source": "/presentation/cover.jpg", "destination": "https://ieaum.ir/egtesadkalan/cover.jpg" },
    { "source": "/presentation/Vazirmatn.woff2", "destination": "https://ieaum.ir/egtesadkalan/Vazirmatn.woff2" },
    { "source": "/presentation/OFL.txt", "destination": "https://ieaum.ir/egtesadkalan/OFL.txt" }
  ],
  "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; connect-src 'self'; img-src 'self' blob:; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "installCommand": "npm ci",
  "crons": [{ "path": "/api/week", "schedule": "30 3 * * *" }]
}
